<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Voxel Engine</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; user-select: none; }
        
        /* UI OVERLAYS */
        #ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
        
        /* CROSSHAIR */
        #crosshair {
            position: absolute; top: 50%; left: 50%; width: 20px; height: 20px;
            background: transparent; border: 2px solid rgba(255, 255, 255, 0.8);
            transform: translate(-50%, -50%); border-radius: 50%;
            z-index: 10;
        }
        #crosshair::after {
            content: ''; position: absolute; top: 50%; left: 50%; width: 4px; height: 4px;
            background: white; transform: translate(-50%, -50%); border-radius: 50%;
        }

        /* INFO & FPS */
        #info { position: absolute; top: 10px; left: 10px; color: white; text-shadow: 1px 1px 0 #000; }
        #save-status { margin-top: 5px; color: #ffff00; font-size: 0.8em; opacity: 0; transition: opacity 1s; }

        /* HOTBAR */
        #hotbar {
            position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
            display: flex; gap: 5px; background: rgba(0, 0, 0, 0.5); padding: 5px; border-radius: 5px;
            pointer-events: auto;
        }
        .slot {
            width: 40px; height: 40px; border: 2px solid #555; cursor: pointer;
            display: flex; justify-content: center; align-items: center; font-size: 12px; color: white;
            text-shadow: 1px 1px 0 #000; transition: transform 0.1s;
        }
        .slot.active { border-color: white; transform: scale(1.1); background: rgba(255,255,255,0.2); }

        /* HOME SCREEN */
        #menu {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            color: white; z-index: 100; pointer-events: auto;
        }
        h1 { font-size: 4rem; margin-bottom: 0; text-shadow: 4px 4px 0 #333; }
        p { color: #ccc; margin-bottom: 30px; }
        button {
            padding: 15px 40px; font-size: 1.5rem; cursor: pointer;
            background: #4CAF50; color: white; border: none; border-radius: 5px;
            box-shadow: 0 5px #2E7D32; transition: all 0.1s;
        }
        button:active { transform: translateY(5px); box-shadow: 0 0 #2E7D32; }
        button.secondary { background: #d32f2f; box-shadow: 0 5px #b71c1c; margin-top: 10px; font-size: 1rem; padding: 10px 20px;}
        button.secondary:active { transform: translateY(5px); box-shadow: 0 0 #b71c1c; }

        /* LOADING */
        #loader { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-size: 20px; z-index: 90;}
    </style>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
</head>
<body>

    <div id="menu">
        <h1>VOXEL JS</h1>
        <p>WASD to Move | SPACE to Jump | CLICK to Mine/Place | 1-4 Change Block</p>
        <button id="start-btn">PLAY GAME</button>
        <button id="reset-btn" class="secondary">CLEAR SAVE DATA</button>
    </div>

    <div id="ui-layer">
        <div id="crosshair"></div>
        <div id="info">
            <div id="fps">FPS: 0</div>
            <div id="coords">X: 0 Y: 0 Z: 0</div>
            <div id="chunks-loaded">Chunks: 0</div>
            <div id="save-status">World Saved!</div>
        </div>
        <div id="hotbar">
            </div>
    </div>

    <div id="loader">Generating World...</div>

    <script type="module">
        import * as THREE from 'three';
        import { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';
        
        // --- CONFIGURATION ---
        const CHUNK_SIZE = 16;
        const RENDER_DISTANCE = 4; // Radius of chunks to render
        const BLOCK_SIZE = 1;
        const WORLD_HEIGHT_OFFSET = 10;
        
        // --- STATE ---
        let camera, scene, renderer, controls;
        let raycaster;
        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false, canJump = false;
        let prevTime = performance.now();
        let velocity = new THREE.Vector3();
        let direction = new THREE.Vector3();
        let chunks = {}; // Stores chunk meshes
        let worldData = {}; // Stores block modifications: "x,y,z": type
        let activeBlockType = 1; // 1: Grass, 2: Dirt, 3: Stone, 4: Wood
        let frameCount = 0;
        let lastFpsTime = 0;

        // --- COLORS / MATERIALS ---
        // Generating simple textures via canvas to avoid external assets issues
        function createTexture(color) {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = color;
            ctx.fillRect(0,0,64,64);
            // Add some noise
            for(let i=0; i<200; i++){
                ctx.fillStyle = `rgba(0,0,0,${Math.random() * 0.2})`;
                ctx.fillRect(Math.random()*64, Math.random()*64, 4, 4);
            }
            // Border
            ctx.strokeStyle = "rgba(0,0,0,0.1)";
            ctx.lineWidth = 4;
            ctx.strokeRect(0,0,64,64);
            
            const tex = new THREE.CanvasTexture(canvas);
            tex.magFilter = THREE.NearestFilter;
            return tex;
        }

        const materials = [
            null, // 0 is air
            new THREE.MeshLambertMaterial({ map: createTexture('#7CFC00') }), // 1: Grass
            new THREE.MeshLambertMaterial({ map: createTexture('#8B4513') }), // 2: Dirt
            new THREE.MeshLambertMaterial({ map: createTexture('#808080') }), // 3: Stone
            new THREE.MeshLambertMaterial({ map: createTexture('#A0522D') }), // 4: Wood
        ];

        // --- SIMPLEX NOISE IMPLEMENTATION (Simplified) ---
        // A simple pseudo-random noise function for terrain generation
        class SimpleNoise {
            constructor() {
                this.perm = new Uint8Array(512);
                for(let i=0; i<256; i++) this.perm[i] = this.perm[i+256] = Math.floor(Math.random()*256);
            }
            grad(hash, x, y, z) {
                const h = hash & 15;
                const u = h < 8 ? x : y, v = h < 4 ? y : h === 12 || h === 14 ? x : z;
                return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
            }
            noise(x, y, z) {
                const X = Math.floor(x) & 255, Y = Math.floor(y) & 255, Z = Math.floor(z) & 255;
                x -= Math.floor(x); y -= Math.floor(y); z -= Math.floor(z);
                const u = x*x*x*(x*(x*6-15)+10), v = y*y*y*(y*(y*6-15)+10), w = z*z*z*(z*(z*6-15)+10);
                const A = this.perm[X]+Y, AA = this.perm[A]+Z, AB = this.perm[A+1]+Z,
                      B = this.perm[X+1]+Y, BA = this.perm[B]+Z, BB = this.perm[B+1]+Z;
                return this.lerp(w, this.lerp(v, this.lerp(u, this.grad(this.perm[AA], x, y, z),
                    this.grad(this.perm[BA], x-1, y, z)), this.lerp(u, this.grad(this.perm[AB], x, y-1, z),
                    this.grad(this.perm[BB], x-1, y-1, z))), this.lerp(v, this.lerp(u, this.grad(this.perm[AA+1], x, y, z-1),
                    this.grad(this.perm[BA+1], x-1, y, z-1)), this.lerp(u, this.grad(this.perm[AB+1], x, y-1, z-1),
                    this.grad(this.perm[BB+1], x-1, y-1, z-1))));
            }
            lerp(t, a, b) { return a + t * (b - a); }
        }
        const noiseGen = new SimpleNoise();

        // --- INIT ---
        init();
        animate();

        function init() {
            // Load saved world
            const savedData = localStorage.getItem('voxelWorldData');
            if (savedData) {
                try { worldData = JSON.parse(savedData); } catch(e) { console.error("Save file corrupted"); }
            }

            // Setup
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.y = 20;

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87CEEB); // Sky blue
            scene.fog = new THREE.Fog(0x87CEEB, 10, RENDER_DISTANCE * CHUNK_SIZE - 5);

            // Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(50, 100, 50);
            scene.add(dirLight);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: false }); // Disable AA for performance
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.body.appendChild(renderer.domElement);

            // Controls
            controls = new PointerLockControls(camera, document.body);
            
            // Raycaster
            raycaster = new THREE.Raycaster();
            raycaster.far = 8; // Reach distance

            // Event Listeners
            document.getElementById('start-btn').addEventListener('click', () => controls.lock());
            document.getElementById('reset-btn').addEventListener('click', () => {
                localStorage.removeItem('voxelWorldData');
                location.reload();
            });

            controls.addEventListener('lock', () => document.getElementById('menu').style.display = 'none');
            controls.addEventListener('unlock', () => document.getElementById('menu').style.display = 'flex');

            document.addEventListener('keydown', onKeyDown);
            document.addEventListener('keyup', onKeyUp);
            document.addEventListener('mousedown', onMouseClick);
            window.addEventListener('resize', onWindowResize);

            // UI Init
            initHotbar();
        }

        function initHotbar() {
            const hotbar = document.getElementById('hotbar');
            const blockNames = ["Grass", "Dirt", "Stone", "Wood"];
            
            blockNames.forEach((name, index) => {
                const typeId = index + 1;
                const slot = document.createElement('div');
                slot.className = `slot ${index === 0 ? 'active' : ''}`;
                slot.innerText = name;
                slot.onclick = () => selectBlock(typeId, slot);
                hotbar.appendChild(slot);
            });
        }

        function selectBlock(id, slotElement) {
            activeBlockType = id;
            document.querySelectorAll('.slot').forEach(s => s.classList.remove('active'));
            if(slotElement) slotElement.classList.add('active');
            else document.querySelectorAll('.slot')[id-1].classList.add('active');
        }

        // --- WORLD GENERATION LOGIC ---

        function getChunkKey(cx, cz) {
            return `${cx},${cz}`;
        }

        function getBlockAt(x, y, z) {
            const key = `${Math.round(x)},${Math.round(y)},${Math.round(z)}`;
            if (worldData[key] !== undefined) {
                return worldData[key];
            }
            
            // Procedural Generation
            // Simple heightmap noise
            const scale = 0.05;
            const height = Math.floor(noiseGen.noise(x * scale, 0, z * scale) * 10 + WORLD_HEIGHT_OFFSET);
            
            if (y < height - 3) return 3; // Stone
            if (y < height) return 2; // Dirt
            if (y === height) return 1; // Grass
            
            return 0; // Air
        }

        // Generate a chunk geometry
        // Note: For a real engine, we would use InstancedMesh or merge geometries.
        // For this prototype, we will use a naive approach but batched by chunk to keep it manageable.
        function generateChunk(cx, cz) {
            const chunkGroup = new THREE.Group();
            
            // To optimize, we only check blocks that are exposed (naive face culling would be better)
            // For this HTML demo, we will check strictly neighbors.
            
            const dummy = new THREE.Object3D();
            const geometries = [];
            const materialIndices = [];

            // We will use InstancedMesh for performance. 
            // One InstancedMesh per material type per chunk.
            const instances = {}; // { materialIndex: [matrix data] }

            for (let x = 0; x < CHUNK_SIZE; x++) {
                for (let z = 0; z < CHUNK_SIZE; z++) {
                    const wx = cx * CHUNK_SIZE + x;
                    const wz = cz * CHUNK_SIZE + z;
                    
                    // Optimization: Only scan relevant height
                    // We scan from bottom up to a reasonable cap
                    for (let y = 0; y < 30; y++) {
                        const type = getBlockAt(wx, y, wz);
                        if (type !== 0) {
                            // Check exposure (simple occlusion culling)
                            // If surrounded by solid blocks, don't render
                            const top = getBlockAt(wx, y+1, wz);
                            const bottom = getBlockAt(wx, y-1, wz);
                            const left = getBlockAt(wx-1, y, wz);
                            const right = getBlockAt(wx+1, y, wz);
                            const front = getBlockAt(wx, y, wz+1);
                            const back = getBlockAt(wx, y, wz-1);

                            if (top && bottom && left && right && front && back) continue;

                            if (!instances[type]) instances[type] = [];
                            
                            dummy.position.set(wx, y, wz);
                            dummy.updateMatrix();
                            instances[type].push(dummy.matrix.clone());
                        }
                    }
                }
            }

            // Create meshes from instances
            const geometry = new THREE.BoxGeometry(1, 1, 1);
            for (const type in instances) {
                const mesh = new THREE.InstancedMesh(geometry, materials[type], instances[type].length);
                for (let i = 0; i < instances[type].length; i++) {
                    mesh.setMatrixAt(i, instances[type][i]);
                }
                mesh.castShadow = true;
                mesh.receiveShadow = true;
                chunkGroup.add(mesh);
                
                // Store metadata for raycasting interaction
                mesh.userData = { isChunkMesh: true, cx, cz };
            }

            return chunkGroup;
        }

        function updateChunks() {
            const px = Math.floor(camera.position.x / CHUNK_SIZE);
            const pz = Math.floor(camera.position.z / CHUNK_SIZE);

            // Load new chunks
            for (let x = -RENDER_DISTANCE; x <= RENDER_DISTANCE; x++) {
                for (let z = -RENDER_DISTANCE; z <= RENDER_DISTANCE; z++) {
                    const cx = px + x;
                    const cz = pz + z;
                    const key = getChunkKey(cx, cz);

                    if (!chunks[key]) {
                        const chunk = generateChunk(cx, cz);
                        scene.add(chunk);
                        chunks[key] = chunk;
                    }
                }
            }

            // Unload far chunks
            for (const key in chunks) {
                const [cx, cz] = key.split(',').map(Number);
                const dist = Math.sqrt((cx - px)**2 + (cz - pz)**2);
                if (dist > RENDER_DISTANCE + 1) {
                    scene.remove(chunks[key]);
                    // Dispose geometry/material to prevent leaks
                    chunks[key].children.forEach(c => c.dispose && c.dispose()); 
                    delete chunks[key];
                }
            }

            // Update UI Info
            document.getElementById('coords').innerText = `X: ${Math.round(camera.position.x)} Y: ${Math.round(camera.position.y)} Z: ${Math.round(camera.position.z)}`;
            document.getElementById('chunks-loaded').innerText = `Chunks: ${Object.keys(chunks).length}`;
        }

        // Rebuild a specific chunk (used after block modification)
        function refreshChunk(cx, cz) {
            const key = getChunkKey(cx, cz);
            if (chunks[key]) {
                scene.remove(chunks[key]);
                const newChunk = generateChunk(cx, cz);
                scene.add(newChunk);
                chunks[key] = newChunk;
            }
        }

        // --- INTERACTION ---

        function onMouseClick(event) {
            if (!controls.isLocked) return;
            
            // 0: Left (Mine), 2: Right (Place)
            if (event.button !== 0 && event.button !== 2) return;

            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            
            // We need to intersect with the InstancedMeshes
            const intersects = raycaster.intersectObjects(scene.children, true);

            if (intersects.length > 0) {
                const intersect = intersects[0];
                
                // Calculate position of the block
                // Because we use InstancedMesh, the matrixWorld is the mesh, not the instance.
                // However, intersect.point is accurate.
                // We nudge the point slightly inside or outside the block to find grid coords.
                
                const p = intersect.point;
                const n = intersect.face.normal;
                
                // Coordinate for the existing block
                const mx = Math.floor(p.x - n.x * 0.1);
                const my = Math.floor(p.y - n.y * 0.1);
                const mz = Math.floor(p.z - n.z * 0.1);

                if (event.button === 0) {
                    // MINE (Remove Block)
                    setBlock(mx, my, mz, 0);
                } else if (event.button === 2) {
                    // PLACE (Add Block)
                    const px = Math.floor(p.x + n.x * 0.1);
                    const py = Math.floor(p.y + n.y * 0.1);
                    const pz = Math.floor(p.z + n.z * 0.1);
                    
                    // Don't place inside player
                    const playerPos = camera.position;
                    if (Math.abs(px - playerPos.x) < 0.8 && Math.abs(pz - playerPos.z) < 0.8 && Math.abs(py - (playerPos.y - 1)) < 1.5) {
                        return; // Too close
                    }

                    setBlock(px, py, pz, activeBlockType);
                }
            }
        }

        function setBlock(x, y, z, type) {
            const key = `${x},${y},${z}`;
            worldData[key] = type;
            saveWorld();

            // Refresh chunk(s)
            const cx = Math.floor(x / CHUNK_SIZE);
            const cz = Math.floor(z / CHUNK_SIZE);
            refreshChunk(cx, cz);

            // If on edge, refresh neighbor
            if (x % CHUNK_SIZE === 0) refreshChunk(cx - 1, cz);
            if (x % CHUNK_SIZE === CHUNK_SIZE - 1) refreshChunk(cx + 1, cz);
            if (z % CHUNK_SIZE === 0) refreshChunk(cx, cz - 1);
            if (z % CHUNK_SIZE === CHUNK_SIZE - 1) refreshChunk(cx, cz + 1);
        }

        function saveWorld() {
            localStorage.setItem('voxelWorldData', JSON.stringify(worldData));
            const status = document.getElementById('save-status');
            status.style.opacity = 1;
            setTimeout(() => status.style.opacity = 0, 2000);
        }

        // --- MOVEMENT & INPUT ---

        function onKeyDown(event) {
            switch (event.code) {
                case 'ArrowUp': case 'KeyW': moveForward = true; break;
                case 'ArrowLeft': case 'KeyA': moveLeft = true; break;
                case 'ArrowDown': case 'KeyS': moveBackward = true; break;
                case 'ArrowRight': case 'KeyD': moveRight = true; break;
                case 'Space': if (canJump) { velocity.y += 35; canJump = false; } break;
                case 'Digit1': selectBlock(1); break;
                case 'Digit2': selectBlock(2); break;
                case 'Digit3': selectBlock(3); break;
                case 'Digit4': selectBlock(4); break;
            }
        }

        function onKeyUp(event) {
            switch (event.code) {
                case 'ArrowUp': case 'KeyW': moveForward = false; break;
                case 'ArrowLeft': case 'KeyA': moveLeft = false; break;
                case 'ArrowDown': case 'KeyS': moveBackward = false; break;
                case 'ArrowRight': case 'KeyD': moveRight = false; break;
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- ANIMATION LOOP ---

        function animate() {
            requestAnimationFrame(animate);

            // FPS Counter
            const now = performance.now();
            frameCount++;
            if (now - lastFpsTime >= 1000) {
                document.getElementById('fps').innerText = `FPS: ${frameCount}`;
                frameCount = 0;
                lastFpsTime = now;
            }

            if (controls.isLocked === true) {
                const time = performance.now();
                const delta = (time - prevTime) / 1000;

                velocity.x -= velocity.x * 10.0 * delta;
                velocity.z -= velocity.z * 10.0 * delta;
                velocity.y -= 9.8 * 10.0 * delta; // Gravity

                direction.z = Number(moveForward) - Number(moveBackward);
                direction.x = Number(moveRight) - Number(moveLeft);
                direction.normalize();

                if (moveForward || moveBackward) velocity.z -= direction.z * 40.0 * delta;
                if (moveLeft || moveRight) velocity.x -= direction.x * 40.0 * delta;

                // Simple collision detection (Floor)
                // We just check the block directly below the camera
                const playerHeight = 1.6;
                const x = Math.round(camera.position.x);
                const z = Math.round(camera.position.z);
                const y = Math.floor(camera.position.y - playerHeight); 
                
                const blockBelow = getBlockAt(x, y, z);
                
                if (blockBelow !== 0) {
                    // Collision with ground
                    velocity.y = Math.max(0, velocity.y);
                    canJump = true;
                    // Snap to top of block if falling into it
                    if (camera.position.y < y + 1 + playerHeight) {
                        camera.position.y = y + 1 + playerHeight;
                    }
                }

                controls.moveRight(-velocity.x * delta);
                controls.moveForward(-velocity.z * delta);
                camera.position.y += velocity.y * delta;

                // World limit (fall into void)
                if (camera.position.y < -50) {
                    camera.position.y = 50;
                    velocity.y = 0;
                }

                prevTime = time;

                // Dynamic world loading
                updateChunks();
            } else {
                prevTime = performance.now();
            }

            renderer.render(scene, camera);
        }
    </script>
</body>
</html>
